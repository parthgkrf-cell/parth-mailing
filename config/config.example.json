{
  "notes": [
    "Copy this file to config.json. The relay does that automatically on first launch.",
    "Only addresses ending with domain_suffix can sign in.",
    "Leave SMTP passwords empty to run in simulation mode. Sign-in codes then appear on the sign-in screen.",
    "Put real mailbox passwords here on the machine that runs the relay. They are never sent to the browser.",
    "Set dispatch_mode to live after the master SMTP password is filled in.",
    "Share a Google Drive folder with the service account email, then set google_drive.enabled to true."
  ],
  "domain_suffix": "@gr-conferences.com",
  "token_secret": "change-me",
  "session_hours": 12,
  "otp_ttl_seconds": 300,
  "dispatch_mode": "auto",
  "other_daily_cap": 500,
  "master_emails": [
    "master@gr-conferences.com"
  ],
  "server": {
    "host": "127.0.0.1",
    "port": 8787
  },
  "master_smtp": {
    "host": "smtp.gmail.com",
    "port": 465,
    "secure": "ssl",
    "user": "master@gr-conferences.com",
    "password": "",
    "from_name": "Parth Mailing"
  },
  "senders": [
    {
      "id": "info",
      "email": "info@gr-conferences.com",
      "display_name": "GR Conferences",
      "host": "smtp.gmail.com",
      "port": 465,
      "secure": "ssl",
      "user": "info@gr-conferences.com",
      "password": ""
    }
  ],
  "default_limits": {
    "per_minute": 10,
    "per_hour": 100,
    "per_day": 500,
    "max_batch": 5000,
    "window_start": "09:00",
    "window_end": "18:00",
    "window_tz": "UTC",
    "enforce_window": false
  },
  "pace": {
    "delay_min_seconds": 4,
    "delay_max_seconds": 12,
    "batch_size": 20,
    "batch_pause_minutes": 2
  },
  "google_sign_in": {
    "client_id": ""
  },
  "google_drive": {
    "enabled": false,
    "service_account_file": "config/drive_service_account.json",
    "parent_folder_id": "",
    "folder_name": "ParthMailing_Storage"
  }
}
